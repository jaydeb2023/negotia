# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: "low" (fastest) | "medium" (follows persona rules better, default) | "high"
# GROQ_REASONING_EFFORT=medium

# PostgreSQL on the VPS
DATABASE_URL=postgresql://negotia:YOUR_DB_PASSWORD@localhost:5432/negotia

# Login (NextAuth)
NEXTAUTH_URL=https://transcendconsultant.com
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=change_me

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails that are always super admins (comma separated)
ADMIN_EMAILS=you@example.com
